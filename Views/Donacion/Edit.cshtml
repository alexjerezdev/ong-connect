@model ONG_connect.ViewModels.DonacionEditViewModel

@{
    ViewData["Title"] = "Editar Donación";
}

<h1>Editar Donación</h1>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdDonacion" />
    <div class="form-group mb-3">
        <label asp-for="NombreDonante" class="control-label"></label>
        <input asp-for="NombreDonante" class="form-control" />
        <span asp-validation-for="NombreDonante" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="TipoDonacion" class="control-label"></label>
        <input asp-for="TipoDonacion" class="form-control" />
        <span asp-validation-for="TipoDonacion" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="ValorEconomico" class="control-label"></label>
        <input asp-for="ValorEconomico" class="form-control" />
        <span asp-validation-for="ValorEconomico" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="FechaDonacion" class="control-label"></label>
        <input asp-for="FechaDonacion" type="date" class="form-control" />
        <span asp-validation-for="FechaDonacion" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="IdProyecto" class="control-label">Proyecto</label>
        <select asp-for="IdProyecto" class="form-control" asp-items="ViewBag.IdProyecto"></select>
        <span asp-validation-for="IdProyecto" class="text-danger"></span>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
