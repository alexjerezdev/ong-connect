@model ONG_connect.Models.Donacion

@{
    ViewData["Title"] = "Detalles de la Donación";
}

<h1>Detalles de la Donación</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NombreDonante)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NombreDonante)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TipoDonacion)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.TipoDonacion)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ValorEconomico)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ValorEconomico)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaDonacion)</dt>
        <dd class="col-sm-9">@Model.FechaDonacion.ToShortDateString()</dd>

        <dt class="col-sm-3">Proyecto</dt>
        <dd class="col-sm-9">@Model.Proyecto?.Nombre</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdDonacion" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
