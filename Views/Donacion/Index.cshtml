@model IEnumerable<ONG_connect.Models.Donacion>

@{
    ViewData["Title"] = "Donaciones";
}

<h1>Donaciones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nueva</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.NombreDonante)</th>
            <th>@Html.DisplayNameFor(model => model.TipoDonacion)</th>
            <th>@Html.DisplayNameFor(model => model.ValorEconomico)</th>
            <th>@Html.DisplayNameFor(model => model.FechaDonacion)</th>
            <th>Proyecto</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.NombreDonante)</td>
            <td>@Html.DisplayFor(modelItem => item.TipoDonacion)</td>
            <td>@Html.DisplayFor(modelItem => item.ValorEconomico)</td>
            <td>@item.FechaDonacion.ToShortDateString()</td>
            <td>@item.Proyecto?.Nombre</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.IdDonacion" class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.IdDonacion" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdDonacion" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
<button id="btnCargar" class="btn btn-info mt-3">Cargar Donaciones vía AJAX</button>
<div id="listaDonaciones" class="mt-3"></div>

@section Scripts {
<script>
    document.getElementById("btnCargar").addEventListener("click", async () => {
        const contenedor = document.getElementById("listaDonaciones");
        contenedor.innerHTML = '<div class="spinner-border text-primary"></div>';

        try {
            const respuesta = await fetch("/api/DonacionesApi");
            if (!respuesta.ok) throw new Error("Error en la red");

            const datos = await respuesta.json();

            contenedor.innerHTML = "";
            datos.forEach(d => {
                contenedor.innerHTML += `
                    <div class="alert alert-secondary">
                        <strong>${d.nombreDonante}</strong> - ${d.tipoDonacion}
                        (${d.valorEconomico} Bs) — ${new Date(d.fechaDonacion).toLocaleDateString()}
                    </div>`;
            });
        } catch (error) {
            contenedor.innerHTML = `<p class="text-danger">Error: ${error.message}</p>`;
        }
    });
</script>
}