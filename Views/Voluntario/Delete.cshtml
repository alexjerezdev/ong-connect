@model ONG_connect.Models.Voluntario

@{
    ViewData["Title"] = "Eliminar Voluntario";
}

<h1>Eliminar Voluntario</h1>

<h3>¿Está seguro de que desea eliminar este registro?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Telefono)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Telefono)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Estado)</dt>
        <dd class="col-sm-9">@(Model.Estado ? "Activo" : "Inactivo")</dd>

        <dt class="col-sm-3">Proyecto</dt>
        <dd class="col-sm-9">@Model.Proyecto?.Nombre</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdVoluntario" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>
