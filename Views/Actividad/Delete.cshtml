@model ONG_connect.Models.Actividad

@{
    ViewData["Title"] = "Eliminar Actividad";
}

<h1>Eliminar Actividad</h1>

<h3>¿Está seguro de que desea eliminar este registro?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Fecha)</dt>
        <dd class="col-sm-9">@Model.Fecha.ToShortDateString()</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Responsable)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Responsable)</dd>

        <dt class="col-sm-3">Proyecto</dt>
        <dd class="col-sm-9">@Model.Proyecto?.Nombre</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdActividad" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>
