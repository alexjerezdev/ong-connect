@model IEnumerable<ONG_connect.Models.Beneficiario>

@{
    ViewData["Title"] = "Beneficiarios";
}

<h1>Beneficiarios</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.TipoBeneficiario)</th>
            <th>@Html.DisplayNameFor(model => model.CantidadAyuda)</th>
            <th>Proyecto</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
            <td>@Html.DisplayFor(modelItem => item.TipoBeneficiario)</td>
            <td>@Html.DisplayFor(modelItem => item.CantidadAyuda)</td>
            <td>@item.Proyecto?.Nombre</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.IdBeneficiario" class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.IdBeneficiario" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdBeneficiario" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
