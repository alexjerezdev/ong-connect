@model IEnumerable<ONG_connect.Models.Proyecto>

@{
    ViewData["Title"] = "Proyectos";
}

<h1>Proyectos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Responsable)</th>
            <th>@Html.DisplayNameFor(model => model.Presupuesto)</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>Usuario</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
            <td>@Html.DisplayFor(modelItem => item.Responsable)</td>
            <td>@Html.DisplayFor(modelItem => item.Presupuesto)</td>
            <td>@Html.DisplayFor(modelItem => item.Estado)</td>
            <td>@item.Usuario?.Nombre</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.IdProyecto" class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.IdProyecto" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdProyecto" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
