@model ONG_connect.Models.Proyecto

@{
    ViewData["Title"] = "Crear Proyecto";
}

<h1>Crear Proyecto</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-3">
        <label asp-for="Nombre" class="control-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Responsable" class="control-label"></label>
        <input asp-for="Responsable" class="form-control" />
        <span asp-validation-for="Responsable" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Presupuesto" class="control-label"></label>
        <input asp-for="Presupuesto" class="form-control" />
        <span asp-validation-for="Presupuesto" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Estado" class="control-label"></label>
        <input asp-for="Estado" class="form-control" />
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="IdUsuario" class="control-label">Usuario responsable</label>
        <select asp-for="IdUsuario" class="form-control" asp-items="ViewBag.IdUsuario"></select>
        <span asp-validation-for="IdUsuario" class="text-danger"></span>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Crear</button>
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
